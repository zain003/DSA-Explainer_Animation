# LLM used for planning and narration (OpenAI-compatible)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Set to "1" to skip LLM calls and use deterministic template plans (offline demo)
OFFLINE_MODE=1

# Piper TTS (local) — download with:
#   python -m piper.download_voices en_US-lessac-medium --data-dir assets/voices
PIPER_BIN=piper
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICE_PATH=assets/voices/en_US-lessac-medium.onnx
# Fallback if Piper is missing: "espeak" | "silent" | "tone"
TTS_FALLBACK=espeak
